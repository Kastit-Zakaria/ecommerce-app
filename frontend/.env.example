# Variables d'environnement du frontend (Vite)
# Copier ce fichier en « .env » (non versionné) puis adapter les valeurs.
# Attention : ces valeurs sont lues au moment du build (npm run build) ;
# il faut donc reconstruire le site après toute modification.

# URL de base de l'API du backend, sans « / » final.
# Développement local : http://localhost:8080/api (valeur par défaut si la variable est absente)
# Production : par exemple https://api.exemple.be/api
VITE_API_URL=http://localhost:8080/api
